# Rebuild the index of xymonapi-rag(1) once a day, so search_history of
# xymonapi-mcp(1) sees recent colour changes. It reads the history from
# xymond's files, with the Xymon environment below: no user or token. Disabled
# as shipped: it needs the Python modules in rag/requirements.txt, and
# XYMONAPI_RAG_DOCS set in a file under xymonserver.d/. Remove DISABLED to
# run it.
[xymonapi-rag]
	DISABLED
	ENVFILE @XYMONHOME@/etc/xymonserver.cfg
	NEEDS xymonapi
	INTERVAL 1d
	CMD $XYMONHOME/ext/xymonapi/rag/xymonapi-rag.sh index
	LOGFILE $XYMONSERVERLOGS/xymonapi-rag.log
